# API
PORT=8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENRIGOR_EXECUTOR=demo

# Local Codex app-server executor (single-user alpha)
# OPENRIGOR_EXECUTOR=codex-app-server
# OPENRIGOR_CODEX_CWD=.
# OPENRIGOR_CODEX_SANDBOX=workspace-write
# OPENRIGOR_CODEX_APPROVAL_POLICY=on-request
# Optional server-wide standard-mode override: low | medium | high | xhigh | max
# Ultra is selected per request with mode=ultra; do not set it here.
# OPENRIGOR_CODEX_EFFORT=medium
# OPENRIGOR_CODEX_EPHEMERAL=true
# OPENRIGOR_CODEX_REQUEST_TIMEOUT_MS=30000
# OPENRIGOR_CODEX_TURN_TIMEOUT_MS=1800000
# OPENRIGOR_CODEX_BIN=codex
# Durable local data and event journals (ignored by Git)
# OPENRIGOR_DATA_DIR=.openrigor
# Optional model for the two-turn real-provider smoke check
# OPENRIGOR_SMOKE_MODEL=gpt-6-luna

# Image API: server-only. You can put this in ignored .env.imagegen.local.
# CIYUANZHIYAN_API_KEY=

# Web
VITE_API_BASE_URL=http://localhost:8787

# Future production integrations (never commit real values)
# DATABASE_URL=postgres://openrigor:openrigor@localhost:5432/openrigor
# REDIS_URL=redis://localhost:6379
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=openrigor
