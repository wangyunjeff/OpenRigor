{
  "name": "@openrigor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openrigor/protocol build && tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @openrigor/protocol build",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@openrigor/protocol": "workspace:*",
    "linkedom": "^0.18.13"
  }
}
