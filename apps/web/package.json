{
  "name": "@openrigor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openrigor/protocol build && vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@openrigor/protocol": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
